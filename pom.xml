<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>br.com.saasfinder</groupId>
    <artifactId>marketplace-saas</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>marketplace-saas</name>
    <description>Marketplace bilingue de solucoes SaaS - catalogo core (spec 001)</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spotless.version>2.44.5</spotless.version>
        <springdoc.version>2.8.9</springdoc.version>
        <!--
          O docker-java usado pelo Testcontainers negocia a API do Docker na versao
          1.32 por padrao, e o Docker 29 recusa qualquer coisa abaixo de 1.40 com
          "client version 1.32 is too old". 1.40 e o valor mais conservador que
          funciona: existe desde o Docker 19.03 e e aceito pelos daemons novos.
          Sobrescreva com -Ddocker.api.version=... se precisar.
        -->
        <docker.api.version>1.40</docker.api.version>
        <jacoco.version>0.8.13</jacoco.version>
        <logstash-logback-encoder.version>8.1</logstash-logback-encoder.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Bean Validation na borda: o dominio recebe dado ja valido (constituicao secao 6). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
          Envio de e-mail do fluxo de verificacao de review (spec 003, plano DT-02).
          E o adapter de SMTP do proprio Spring; escrever um cliente SMTP a mao
          seria reimplementar pior o que ja vem no ecossistema.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- HTTP Basic nas rotas de admin (spec secao 5.2). Provisorio ate a spec 006. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Obrigatorio para Postgres a partir do Flyway 10. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          UUID v7 (constituicao secao 5): ordenavel no tempo, o que mantem os
          indices compactos. O Java 21 so gera v4, e o uuidv7() nativo do
          Postgres so chegou no PG 18 - a stack e PG 16.
        -->
        <!-- Swagger UI e /v3/api-docs (plan.md DT-02, AC-23). -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Ler os arquivos de seed em YAML (plan.md DT-02). Nao vem no starter. -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.uuid</groupId>
            <artifactId>java-uuid-generator</artifactId>
            <version>5.1.0</version>
        </dependency>

        <!--
          Log estruturado em JSON (constituicao secao 6, plano DT-02/DT-11). A versao
          nao vem gerenciada pelo spring-boot-starter-parent: a 8.1 e a linha que exige
          Logback 1.5.x, que e justamente a que o Boot 3.5 traz.
        -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash-logback-encoder.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @ServiceConnection: liga o container ao datasource sem property manual. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              Testes de integracao (*IT) rodam no failsafe; unitarios (*Test), no surefire.
              O spring-boot-starter-parent so declara o failsafe em <pluginManagement>, com
              as execucoes ja definidas: sem esta declaracao o plugin nao entra no build e
              nenhum *IT roda - o build fica verde sem ter testado nada. Por isso o plugin
              aparece aqui sem <executions>: repetir as execucoes cria uma duplicata que o
              Maven pula com "already been run for this configuration".
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <api.version>${docker.api.version}</api.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <api.version>${docker.api.version}</api.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!--
              Formatacao verificada no build. Ligado a fase validate, e nao a verify,
              para o build quebrar em segundos em vez de depois da suite de testes;
              continua falhando em `mvn verify`, como manda o criterio do 001-T02.
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <palantirJavaFormat/>
                        <removeUnusedImports/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              Cobertura: relatorio unico em target/site/jacoco, alimentado tanto pelo
              surefire quanto pelo failsafe (o agente escreve no mesmo jacoco.exec).
              Sem gate numerico nesta fatia - a regra da constituicao e por endpoint,
              nao por porcentagem.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
