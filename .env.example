# Copie para .env e ajuste. O .env nao vai para o repositorio.

# --- Banco ---
# Dentro do compose o host e o nome do servico (db). Rodando a app fora do
# compose, troque por localhost.
DB_URL=jdbc:postgresql://db:5432/saasfinder
DB_USER=saasfinder
DB_PASSWORD=troque-esta-senha
DB_PORT=5432

# --- Aplicacao ---
APP_PORT=8080
APP_DEFAULT_LOCALE=pt-BR

# --- Frontend ---
# Porta do frontend no host. Dentro do compose ele fala com a API pelo nome do
# servico (app), e nao por localhost.
WEB_PORT=3000
# Instancia sem API, usada so pelos testes de resiliencia (perfil `e2e`).
WEB_SEM_API_PORT=3001
# Instancia de escrita, com banco proprio (perfil `e2e-escrita`). A suite
# compartilhada nao escreve (constituicao secao 6), entao os testes que criam
# review rodam contra esta.
WEB_ESCRITA_PORT=3002
APP_ESCRITA_PORT=8081
API_BASE_URL=http://app:8080
# URL publica do site, usada nas canonicas, no hreflang e no JSON-LD. Sem ela o
# site publicaria canonica apontando para localhost.
SITE_URL=http://localhost:3000

# Origens liberadas para chamada de navegador, separadas por virgula.
# Vazio em producao, de proposito: a renderizacao acontece no servidor, entao
# nenhuma pagina chama a API pelo navegador. Preencha so para rodar o
# `next dev` fora do compose, ex.: http://localhost:3000
CORS_ALLOWED_ORIGINS=

# --- E-mail (spec 003) ---
# Em desenvolvimento o destino e o Mailpit do compose (`docker compose --profile
# dev up`), que segura as mensagens em http://localhost:8025 e nao entrega nada
# para fora. Em producao, troque pelo SMTP de verdade.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=reviews@localhost
# Portas do Mailpit no host: SMTP e interface/API.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Politica de reviews (spec 003) ---
# Endereco publicado na politica para contestar uma avaliacao, e o prazo de
# resposta em dias uteis. Sao COMPROMISSOS PUBLICOS: o padrao usa example.com,
# que a IANA reserva para documentacao, justamente para nao parecer um endereco
# de verdade que ninguem le. Preencha antes de publicar.
REVIEWS_CONTATO=contestacao@example.com
REVIEWS_PRAZO_DIAS=10

# --- Limite de taxa (spec 003) ---
# Envio de review e reenvio de link, por IP. Padrao: 1 por minuto e 5 por hora.
RATE_LIMIT_POR_MINUTO=1
RATE_LIMIT_POR_HORA=5
# Ligue APENAS se houver um proxy reverso de verdade na frente da API. Sem ele,
# qualquer um forja X-Forwarded-For e contorna o limite.
TRUST_FORWARDED_FOR=false

# --- Curadoria ---
# HTTP Basic provisorio, so para o admin do catalogo (spec 001, secao 2).
# Substituido na spec 006-identidade.
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# --- Seed ---
# true carrega o catalogo inicial quando o banco esta vazio.
SEED_ENABLED=false
